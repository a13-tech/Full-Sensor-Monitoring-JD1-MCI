#include <WiFi.h>
#include <WebServer.h>
#include <Wire.h>
#include <U8g2lib.h>
#include <OneWire.h>
#include <DallasTemperature.h>

// --- KONFIGURASI WIFI ACCESS POINT (AP) ---
const char* ap_ssid = "ESP32-Monitoring";  // Nama Wi-Fi buatan ESP32
const char* ap_password = "password123";   // Password Wi-Fi (Minimal 8 Karakter)

WebServer server(80);

// --- KONFIGURASI OLED 1.3 INCI (SH1106 I2C) ---
// GPIO 23 = SDA, GPIO 22 = SCL
U8G2_SH1106_128X64_NONAME_F_HW_I2C u8g2(U8G2_R0, /* reset=*/ U8X8_PIN_NONE, /* clock=*/ 22, /* data=*/ 23);

// --- PIN DEFINITION ---
#define DS18B20_PIN 4
#define TRIG_PIN    5
#define ECHO_PIN    18
#define PIR_PIN     19
#define IR_PIN      21

// Setup DS18B20
OneWire oneWire(DS18B20_PIN);
DallasTemperature tempSensor(&oneWire);

// Variable Global Data Sensor
float suhuC = 0.0;
float jarakCm = 0.0;
bool adaGerakan = false;
bool terhalangIR = false;

// Function Membaca Sensor
void bacaSensor() {
  // DS18B20
  tempSensor.requestTemperatures();
  suhuC = tempSensor.getTempCByIndex(0);

  // HC-SR04
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);
  long duration = pulseIn(ECHO_PIN, HIGH);
  jarakCm = duration * 0.034 / 2.0;

  // HC-SR501 & IR
  adaGerakan = (digitalRead(PIR_PIN) == HIGH);
  terhalangIR = (digitalRead(IR_PIN) == LOW); 
}

// Function Update Tampilan OLED
void updateOLED() {
  u8g2.clearBuffer();
  
  u8g2.setFont(u8g2_font_ncenB08_tr);
  u8g2.drawStr(0, 10, "ESP32 AP MONITOR");
  u8g2.drawLine(0, 13, 128, 13);

  u8g2.setCursor(0, 26);
  u8g2.print("IP: 192.168.4.1");

  u8g2.setCursor(0, 38);
  u8g2.print("Suhu  : "); u8g2.print(suhuC, 1); u8g2.print(" C");

  u8g2.setCursor(0, 48);
  u8g2.print("Jarak : "); u8g2.print(jarakCm, 1); u8g2.print(" cm");

  u8g2.setCursor(0, 58);
  u8g2.print("PIR:"); u8g2.print(adaGerakan ? "GERAK" : "AMAN");
  u8g2.print(" | IR:"); u8g2.print(terhalangIR ? "OBJEK" : "BEBAS");

  u8g2.sendBuffer();
}

// Function Tampilan Web Server (HTML)
void handleRoot() {
  String html = "<!DOCTYPE html><html><head><title>ESP32 Local Monitoring</title>";
  html += "<meta name='viewport' content='width=device-width, initial-scale=1' http-equiv='refresh' content='2'>";
  html += "<style>body{font-family:Arial;text-align:center;margin-top:30px;background:#1a1a1a;color:#fff;}";
  html += ".card{background:#2d2d2d;padding:20px;margin:auto;width:85%;max-width:400px;border-radius:12px;box-shadow:0 4px 10px rgba(0,0,0,0.5);}";
  html += ".val{font-size:20px;font-weight:bold;margin:12px 0;background:#3a3a3a;padding:10px;border-radius:8px;}</style></head><body>";
  html += "<div class='card'><h2>ESP32 AP Dashboard</h2>";
  html += "<div class='val'>Suhu: " + String(suhuC, 1) + " &deg;C</div>";
  html += "<div class='val'>Jarak: " + String(jarakCm, 1) + " cm</div>";
  html += "<div class='val'>PIR: " + String(adaGerakan ? "<span style='color:#ff4d4d;'>Ada Gerakan</span>" : "<span style='color:#4dff88;'>Aman</span>") + "</div>";
  html += "<div class='val'>IR: " + String(terhalangIR ? "<span style='color:#ff4d4d;'>Terhalang</span>" : "<span style='color:#4dff88;'>Bebas</span>") + "</div>";
  html += "</div></body></html>";
  
  server.send(200, "text/html", html);
}

void setup() {
  Serial.begin(115200);

  // Inisialisasi OLED
  u8g2.begin();

  // Inisialisasi Pin Sensor
  tempSensor.begin();
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  pinMode(PIR_PIN, INPUT);
  pinMode(IR_PIN, INPUT);

  // Set ESP32 ke Mode Access Point
  WiFi.softAP(ap_ssid, ap_password);
  
  IPAddress IP = WiFi.softAPIP();
  Serial.println("\nAccess Point Berhasil Dibuat!");
  Serial.print("Nama Wi-Fi : ");
  Serial.println(ap_ssid);
  Serial.print("IP Address : ");
  Serial.println(IP); // Secara default IP Access Point adalah 192.168.4.1

  // Setup Web Server
  server.on("/", handleRoot);
  server.begin();
}

void loop() {
  server.handleClient(); // Menangani request dari browser
  
  static unsigned long lastUpdate = 0;
  if (millis() - lastUpdate >= 1000) { // Update data sensor & OLED setiap 1 detik
    lastUpdate = millis();
    bacaSensor();
    updateOLED();
  }
}
