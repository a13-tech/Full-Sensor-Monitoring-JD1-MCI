#include <Arduino.h>
#include <WiFi.h>
#include <WebServer.h>
#include <Wire.h>
#include <U8g2lib.h>
#include <OneWire.h>
#include <DallasTemperature.h>

// =========================================================================
// KONFIGURASI WIFI ACCESS POINT (AP) - MCI CREATIVE TEAM
// =========================================================================
const char* ap_ssid = "MCI JD1";          // SSID
const char* ap_password = "CREATIVETEAM";  // Password Wi-Fi

WebServer server(80);

// =========================================================================
// DRIVER OLED 1.3 INCI (SH1106 I2C)
// GPIO 22 = SCL, GPIO 23 = SDA
// =========================================================================
U8G2_SH1106_128X64_NONAME_F_HW_I2C u8g2(U8G2_R0, /* reset=*/ U8X8_PIN_NONE, /* clock=*/ 22, /* data=*/ 23);

// =========================================================================
// PIN DEFINITION
// =========================================================================
#define DS18B20_PIN 4  // Pin Data DS18B20
#define TRIG_PIN    5  // Pin Trig HC-SR04
#define ECHO_PIN    18 // Pin Echo HC-SR04
#define PIR_PIN     25 // Pin OUT HC-SR501 PIR
#define IR_PIN      21 // Pin OUT Sensor IR

// =========================================================================
// INISIALISASI SENSOR & VARIABEL GLOBAL
// =========================================================================
OneWire oneWire(DS18B20_PIN);
DallasTemperature tempSensor(&oneWire);

float suhuC = 0.0;
float jarakCm = 0.0;
bool adaGerakan = false;
bool terhalangIR = false;

// =========================================================================
// FUNGSI PEMBACAAN SENSOR
// =========================================================================
void bacaSensor() {
  // DS18B20
  tempSensor.requestTemperatures();
  suhuC = tempSensor.getTempCByIndex(0);

  // HC-SR04
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);
  long duration = pulseIn(ECHO_PIN, HIGH);
  jarakCm = duration * 0.034 / 2.0;

  // PIR & IR
  adaGerakan = (digitalRead(PIR_PIN) == HIGH);
  terhalangIR = (digitalRead(IR_PIN) == LOW); // Active LOW
}

// =========================================================================
// FUNGSI UPDATE TAMPILAN OLED 1.3 INCI
// =========================================================================
void updateOLED() {
  u8g2.clearBuffer();
  
  u8g2.setFont(u8g2_font_ncenB08_tr);
  u8g2.drawStr(0, 10, "MCI JD1 MONITOR");
  u8g2.drawLine(0, 13, 128, 13);

  u8g2.setCursor(0, 26);
  u8g2.print("IP: 192.168.4.1");

  u8g2.setCursor(0, 38);
  u8g2.print("Suhu  : "); u8g2.print(suhuC, 1); u8g2.print(" C");

  u8g2.setCursor(0, 48);
  u8g2.print("Jarak : "); u8g2.print(jarakCm, 1); u8g2.print(" cm");

  u8g2.setCursor(0, 58);
  u8g2.print("PIR:"); u8g2.print(adaGerakan ? "GERAK" : "AMAN");
  u8g2.print(" | IR:"); u8g2.print(terhalangIR ? "OBJEK" : "BEBAS");

  u8g2.sendBuffer();
}

// =========================================================================
// ENDPOINT DATA JSON (AUTO-REFRESH BACKGROUND)
// =========================================================================
void handleData() {
  String json = "{";
  json += "\"suhu\":" + String(suhuC, 1) + ",";
  json += "\"jarak\":" + String(jarakCm, 1) + ",";
  json += "\"pir\":" + String(adaGerakan ? "true" : "false") + ",";
  json += "\"ir\":" + String(terhalangIR ? "true" : "false");
  json += "}";
  server.send(200, "application/json", json);
}

// =========================================================================
// FUNGSI TAMPILAN WEB SERVER (MCI DASHBOARD)
// =========================================================================
void handleRoot() {
  String html = R"rawliteral(
<!DOCTYPE html>
<html>
<head>
  <title>MCI JD1 Telemetry</title>
  <meta name='viewport' content='width=device-width, initial-scale=1'>
  <style>
    body { font-family: Arial, sans-serif; text-align: center; margin-top: 30px; background: #121212; color: #fff; }
    .card { background: #1e1e1e; padding: 20px; margin: auto; width: 85%; max-width: 400px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.6); border: 1px solid #333; }
    h2 { margin-top: 0; color: #00bcd4; font-size: 22px; }
    .sub { font-size: 11px; color: #888; margin-bottom: 15px; letter-spacing: 1px; }
    .val { font-size: 17px; font-weight: bold; margin: 10px 0; background: #2a2a2a; padding: 12px; border-radius: 8px; text-align: left; display: flex; justify-content: space-between; }
  </style>
</head>
<body>
  <div class='card'>
    <h2>MCI JD1 Dashboard</h2>
    <div class='sub'>CREATIVE & ENGINEERING TEAM</div>
    <div class='val'><span>Suhu Target:</span> <span><span id='suhu'>--</span> &deg;C</span></div>
    <div class='val'><span>Jarak Halangan:</span> <span><span id='jarak'>--</span> cm</span></div>
    <div class='val'><span>Sensor PIR:</span> <span id='pir'>--</span></div>
    <div class='val'><span>Sensor IR:</span> <span id='ir'>--</span></div>
  </div>

  <script>
    function updateData() {
      fetch('/data')
        .then(response => response.json())
        .then(data => {
          document.getElementById('suhu').innerText = data.suhu;
          document.getElementById('jarak').innerText = data.jarak;
          
          let pirElem = document.getElementById('pir');
          pirElem.innerHTML = data.pir 
            ? "<span style='color:#ff4d4d;'>Ada Gerakan</span>" 
            : "<span style='color:#4dff88;'>Aman</span>";
            
          let irElem = document.getElementById('ir');
          irElem.innerHTML = data.ir 
            ? "<span style='color:#ff4d4d;'>Terhalang</span>" 
            : "<span style='color:#4dff88;'>Bebas</span>";
        })
        .catch(err => console.error(err));
    }

    setInterval(updateData, 1000);
    updateData();
  </script>
</body>
</html>
)rawliteral";

  server.send(200, "text/html", html);
}

// =========================================================================
// SETUP UTAMA SYSTEM
// =========================================================================
void setup() {
  Serial.begin(115200);

  // Inisialisasi OLED
  u8g2.begin();

  // Inisialisasi Hardware Sensor
  tempSensor.begin();
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  pinMode(PIR_PIN, INPUT);
  pinMode(IR_PIN, INPUT);

  // Jalankan Access Point Mode
  WiFi.softAP(ap_ssid, ap_password);
  
  IPAddress IP = WiFi.softAPIP();
  Serial.println("\n[MCI SYSTEM ONLINE]");
  Serial.print("SSID       : "); Serial.println(ap_ssid);
  Serial.print("IP Address : "); Serial.println(IP);

  // Routing Web Server
  server.on("/", handleRoot);
  server.on("/data", handleData);
  server.begin();
}

// =========================================================================
// LOOP UTAMA PROGRAM
// =========================================================================
void loop() {
  server.handleClient();
  
  static unsigned long lastUpdate = 0;
  if (millis() - lastUpdate >= 1000) {
    lastUpdate = millis();
    bacaSensor();
    updateOLED();
  }
}
